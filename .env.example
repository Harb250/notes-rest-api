# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# The database name goes after the host, e.g. .../notes-api?retryWrites=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notes-api?retryWrites=true&w=majority

# Long random secret used to sign JWTs. Generate one with:
#   node -p "crypto.randomBytes(32).toString('hex')"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login token stays valid (optional, default 1h)
JWT_EXPIRES_IN=1h

# Front-end origin allowed by CORS (optional; omit to allow any origin in dev)
CLIENT_ORIGIN=http://localhost:5173
